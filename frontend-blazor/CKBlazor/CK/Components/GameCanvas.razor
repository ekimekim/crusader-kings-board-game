@using CKBlazor.CK.Screens
@using global::BlazeCanvas
@using global::BlazeCanvas.Components

<canvas id="@($"{Screen.UniqueId}-canvas")"></canvas>

@code {

    [Parameter, EditorRequired]
    public GameCanvasScreen Screen { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Screen.OnCanvasCreated();
    }
}
