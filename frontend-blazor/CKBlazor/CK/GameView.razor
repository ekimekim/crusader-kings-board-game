@using CKBlazor.CK
@using CKBlazor.CK.Data
@using Microsoft.JSInterop
@inject GameService GameService
@inject Services.TimerService TimerService

@code {
    private GameState? GameState;

    protected override async Task OnInitializedAsync()
    {
        await GameService.InitAssets();
        GameState = await GameService.JoinGameAsync("your_game_id", "your_client_guid");
        TimerService.OnTimerElapsed += async () => 
        {
            GameState = await GameService.GetGameState(); 
        };
    }

    string GetRandomModel()
    {
        var models = new string[]
        {
            "#castle-model",
            "#knight-model",
            "#soldier-model",
        };
        return models[Random.Shared.Next() % models.Length];
    }

    string GetRandomAframeRotation()
    {
        var yRot = Random.Shared.Next(360);
        return $"0 {yRot} 0";
    }
}


@if (GameService.TerritoryPositions != null && GameState != null)
{
    <div class="blazecanvas-fill-container">
        <GameCanvas UniqueId="Test">
        </GameCanvas>
    </div>
    <div class="game-hud">
        @foreach (var player in GameState.players)
        {
            <div style="background-color:@player.color;">
                <h3>@player.user.name</h3>

            </div>
        }
    </div> 
}
else
{
    <h3>Loading</h3>
}

