@using CKBlazor.CK
@using CKBlazor.CK.Components
@using CKBlazor.CK.Data
@using CKBlazor.CK.Icons
@using CKBlazor.CK.Screens
@using Microsoft.JSInterop
@inject GameService GameService
@inject Services.TimerService TimerService

@code {
    private GameState? GameState;

    protected override async Task OnInitializedAsync()
    {
        GameService.OnScreenStackChange += OnScreenStackChange;
    }

    void OnScreenStackChange(GameService gameService)
    {
        StateHasChanged();
    }

}

@foreach (var screen in GameService.ScreenStack)
{
    @switch (screen.ScreenType)
    {
        case Screens.ScreenType.DebugMessage:
            <div @key=screen> @((screen as DebugMessageScreen).Message) </div>
            break;
        case Screens.ScreenType.GameCanvas:
            <div @key=screen class="blazecanvas-fill-container">
                <GameCanvas UniqueId="Test">
                </GameCanvas>
                <div id="pin-01" style="position:absolute;left:-10000px;top:-1000px;">
                    <BannerIcon></BannerIcon>
                    <CastleIcon></CastleIcon>
                    <MobilizedIcon></MobilizedIcon>
                </div>
            </div>
            break;
        case Screens.ScreenType.GameHud:
            <div @key=screen class="dynasty-slim" style="color:white;fill:white;position:absolute;left:0;bottom:0;top:auto;right:auto;min-height:14rem">
                <table>
                    <tr>
                        <td>
                            <PortraitSlim></PortraitSlim>
                        </td>
                        <td>
                        </td>
                        <td style="font-size:1rem">
                            AGE: 3<br>
                            COIN: 5<br>
                        </td>
                        <td>
                            <table>
                                <tr>
                                    <td><NavyIcon></NavyIcon></td>
                                    <td><PlateArmorIcon></PlateArmorIcon></td>
                                    <td><LongBowsIcon></LongBowsIcon></td>
                                    <td><PhysicianIcon></PhysicianIcon></td>
                                    <td><ArchbishopIcon></ArchbishopIcon></td>
                                    <td><SpymasterIcon></SpymasterIcon></td>
                                </tr>
                                <tr>
                                    <td><PortraitThumb></PortraitThumb></td>
                                    <td><PortraitThumb></PortraitThumb></td>
                                    <td><PortraitThumb></PortraitThumb></td>
                                    <td><PortraitThumb></PortraitThumb></td>
                                    <td><PortraitThumb></PortraitThumb></td>
                                    <td><PortraitThumb></PortraitThumb></td>
                                </tr>
                            </table>
                        </td>

                    </tr>
                </table>
            </div>
            break;
    }
}

