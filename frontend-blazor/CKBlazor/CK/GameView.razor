@using CKBlazor.CK
@using CKBlazor.CK.Components
@using CKBlazor.CK.Data
@using CKBlazor.CK.Icons
@using Microsoft.JSInterop
@inject GameService GameService
@inject Services.TimerService TimerService

@code {
    private GameState? GameState;

    protected override async Task OnInitializedAsync()
    {
        await GameService.InitAssets();
        GameState = await GameService.JoinGameAsync("your_game_id", "your_client_guid");
        TimerService.OnTimerElapsed += async () => 
        {
            GameState = await GameService.GetGameState(); 
        };
    }

    string GetRandomModel()
    {
        var models = new string[]
        {
            "#castle-model",
            "#knight-model",
            "#soldier-model",
        };
        return models[Random.Shared.Next() % models.Length];
    }

    string GetRandomAframeRotation()
    {
        var yRot = Random.Shared.Next(360);
        return $"0 {yRot} 0";
    }
}


@if (GameService.TerritoryPositions != null && GameState != null)
{
    <div class="blazecanvas-fill-container">
        <GameCanvas UniqueId="Test">
        </GameCanvas>
        <div id="pin-01" style="position:absolute;left:-10000px;top:-1000px;">
            <BannerIcon></BannerIcon>
            <CastleIcon></CastleIcon>
            <MobilizedIcon></MobilizedIcon>
        </div>
    </div>
    <div class="game-hud">
        <div>
            <table>
                <tr>
                    @foreach (var player in GameState.players)
                    {
                        <tr style="background-color:@player.color;">
                            <div>@player.user.name</div>
                        </tr>
                    }
                </tr>
            </table>
        </div>
        <div class="dynasty-slim" style="color:white;fill:white;position:absolute;left:0;bottom:0;top:auto;right:auto;min-height:14rem">
            <table>
                <tr>
                    <td>
                        <PortraitSlim></PortraitSlim>
                    </td>
                    <td>
                    </td>
                    <td style="font-size:1rem">
                        AGE: 3<br>
                        COIN: 5<br>
                    </td>
                    <td>
                        <table>
                            <tr>
                                <td><NavyIcon></NavyIcon></td>
                                <td><PlateArmorIcon></PlateArmorIcon></td>
                                <td><LongBowsIcon></LongBowsIcon></td>
                                <td><PhysicianIcon></PhysicianIcon></td>
                                <td><ArchbishopIcon></ArchbishopIcon></td>
                                <td><SpymasterIcon></SpymasterIcon></td>
                            </tr>
                            <tr>
                                <td><PortraitThumb></PortraitThumb></td>
                                <td><PortraitThumb></PortraitThumb></td>
                                <td><PortraitThumb></PortraitThumb></td>
                                <td><PortraitThumb></PortraitThumb></td>
                                <td><PortraitThumb></PortraitThumb></td>
                                <td><PortraitThumb></PortraitThumb></td>
                            </tr>
                        </table>
                    </td>

                </tr>
            </table>
        </div>
    </div> 
}
else
{
    <h3>Loading</h3>
}

